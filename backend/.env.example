# 复制本文件为 .env 后填写真实值。
# .env 必须加入 .gitignore，绝不能提交。

# ---------- LLM（DeepSeek）----------
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_ID=deepseek-chat

# ---------- 高德开放平台 ----------
# 必须是「Web 服务」类型的 Key（用于后端 REST 调用）
# 注意：前端地图用的是另一种类型（Web 端 JS API），填在前端 .env 里
AMAP_API_KEY=

# ---------- 服务 ----------
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
