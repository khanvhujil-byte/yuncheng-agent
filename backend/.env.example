# 复制本文件为 .env 后填写真实值。
# .env 必须加入 .gitignore，绝不能提交。

# ---------- LLM（DeepSeek）----------
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_ID=deepseek-chat

# ---------- 高德开放平台 ----------
# 必须是「Web 服务」类型的 Key（用于后端 REST 调用）
# 注意：前端地图用的是另一种类型（Web 端 JS API），填在前端 .env 里
AMAP_API_KEY=

# ---------- 服务 ----------
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# ---------- 生成耗时与工具调度 ----------
# 默认直接执行已结构化的检索/天气/酒店工具；仅对照实验时开启ReAct
ATTRACTION_USE_AGENT=false
WEATHER_USE_AGENT=false
HOTEL_USE_AGENT=false
# 并发仍共享高德Key限流；真实路线缓存按精确OD、交通方式、城市与provider隔离
ROUTE_MAX_WORKERS=4
ROUTE_BATCH_BUDGET_SECONDS=12
ROUTE_CACHE_TTL_SECONDS=900
# 社区热度是可选参考：短超时+成功5分钟缓存/失败30秒冷却
COMMUNITY_HOT_TIMEOUT=0.35

# ---------- 本地资料库与天气缓存 ----------
CATALOG_LOCAL_FIRST=true
# 官网成人基础门票采集；目前精确适配故宫与成都熊猫基地，未适配站点不猜价格
OFFICIAL_TICKET_LOOKUP_ENABLED=true
# 无可靠票价时按每景点预留，并明确标为估算，不是景点报价
TICKET_BUDGET_RESERVE_ENABLED=true
TICKET_BUDGET_RESERVE_AMOUNT=100
CATALOG_REFRESH_ENABLED=true
# 首次启动分批预热，之后按更新时间刷新；近期访问城市也加入队列。
CATALOG_PREWARM_CITIES=["北京","杭州","上海","成都","西安"]
CATALOG_REFRESH_TICK_SECONDS=60
CATALOG_REFRESH_CITIES_PER_TICK=2
CATALOG_POI_REFRESH_SECONDS=86400
CATALOG_REFRESH_FAILURE_SECONDS=900
WEATHER_CACHE_TTL_SECONDS=3600
WEATHER_CACHE_FAILURE_COOLDOWN_SECONDS=2

# 上线版本：生产模板覆盖 deployment_mode，浏览器使用登录会话。
DEPLOYMENT_MODE=development
TICKET_MODEL_ESTIMATE_ENABLED=true
TICKET_MODEL_TIMEOUT_SECONDS=15
PLANNING_MAX_CALLS=6
PLANNING_MAX_SECONDS=180
PLANNING_MAX_TOKENS=60000
MCP_REUSE_SESSION=true

# ---------- 飞猪 FlyAI（只读，Node.js >=18） ----------
# 先运行 .venv/Scripts/python.exe scripts/install_flyai.py，固定官方 CLI 1.0.16。
# 可在 Windows 用户环境变量中设置 Key；本文件仅是模板，勿提交真实凭据。
FLYAI_API_KEY=
FLYAI_ENABLED=true
FLYAI_TIMEOUT_SECONDS=12
FLYAI_REQUEST_INTERVAL_SECONDS=1
FLYAI_CACHE_TTL_SECONDS=120
FLYAI_TICKET_QUERY_LIMIT=2
FLYAI_TICKET_BUDGET_SECONDS=5
FLYAI_PLANNING_BUDGET_SECONDS=12
FLYAI_HOTEL_MATCH_LIMIT=4
