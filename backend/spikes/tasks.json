{
  "schema_version": "cpsat-spike-v1",
  "description": "离线 CP-SAT 排程 spike 的固定输入。10 个任务共用一份 POI 注册表；每个任务只声明自己实例化到哪几条 POI（候选池）。两臂（固定排期基线 / CP-SAT）读同一个文件、同一套约束。",
  "constraint_model": {
    "travel_speed_kmh": 18.0,
    "travel_time_status": "estimated",
    "travel_time_note": "haversine 直线距离 / 18 km/h 地面速度，按整分钟四舍五入，单程下限 1 分钟。不是高德路径规划结果，属于'估算通勤'。",
    "open_window_semantics": "open_window 为 null 表示数据集不提供开放时间约束，按整天可用处理（不代表真的全天开放）。",
    "visit_minutes_status": "estimated",
    "visit_minutes_note": "游览时长是人工设定值，不是实测值。",
    "unknown_price_upper_bound_rule": "对每个 ticket_price=null 的 POI，取'同一个任务实例有效候选集中最小的正价格（known 或 estimated）'作为保守上界，并按'所有未知项同时取到该上界'估计总上限。依据：若实际价格达到该值，下面两项中的至少一项必然被超过，所以这个上界在集合层面是保守的（不会低估）。",
    "scoring_note": "打分器独立于求解器实现：自己算通勤、自己算时间线、自己重算预算状态。"
  },
