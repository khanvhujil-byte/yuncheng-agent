# 复制本文件为 .env.local 后填写。
#
# 必须是「Web 端 (JS API)」类型的 Key，不是 Web 服务 Key。
# 用错类型不会报错，只会地图一片空白（需求文档「坑 5」）。
VITE_AMAP_JS_KEY=

# 行程地图用的「Web 服务」Key（静态地图 REST API）。
#
# 和上面的 VITE_AMAP_JS_KEY 不是同一个 Key：高德按平台分 Key 类型，
# 用错类型不会报错，只会返回 {"status":"0","info":"UNKNOWN_ERROR"} 或一张空白图。
# 浏览器会公开此 Key，应使用单独受限的地图 Key，不要复制后端服务密钥。
# 不填也不会白屏 —— TripMap.vue 会自动降级成自绘 SVG 示意图。
VITE_AMAP_STATIC_KEY=

# 默认留空：开发由 Vite 代理 /api，部署后由 nginx 代理。
# 手机访问不能填 127.0.0.1，它指向手机自己。仅跨域部署时填写后端公网 origin。
VITE_API_BASE_URL=
